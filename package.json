{
  "name": "volxen-web",
  "version": "1.0.0",
  "description": "Página web oficial de VOLXEN",
  "main": "config.js",
  "scripts": {
    "dev": "npx tailwindcss -i ./volxen.css -o ./dist/volxen.css --watch",
    "build:css": "npx tailwindcss -i ./volxen.css -o ./dist/volxen.css --minify",
    "build:js": "npx terser js/main.js js/pages/*.js -o dist/main.min.js -c -m",
    "build": "npm run build:css && npm run build:js",
    "serve": "npx serve dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volxendistribution-sudo/volxen-web.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/volxendistribution-sudo/volxen-web/issues"
  },
  "homepage": "https://github.com/volxendistribution-sudo/volxen-web#readme",
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.8.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.0",
    "terser": "^5.51.2"
  }
}